# Novita Sandbox platform key (template build + sandbox lifecycle)
NOVITA_API_KEY=

# OpenAI application key: needs api.agents.read, api.agents.write, api.responses.write.
# Stays in your application. Never enters the sandbox.
OPENAI_API_KEY=

# Restricted OpenAI environment key, created on the platform Agents tab
# (every other permission set to None). This is the only key that enters
# the sandbox, passed to codex exec-server as CODEX_API_KEY.
OPENAI_EXECUTOR_API_KEY=

# Webhook-managed mode only (see src/webhook/README.md).
# Agent the controller serves; it ignores sessions of other agents.
OPENAI_AGENT_ID=
# Signing secret from the OpenAI platform. Leave empty for the first deploy,
# then fill it in and redeploy. Register the webhook in the project that owns
# OPENAI_API_KEY: one in another project of the same org is never delivered.
OPENAI_WEBHOOK_SECRET=

# Agents API endpoint. Only api.openai.com serves it. Set this explicitly if
# your shell exports OPENAI_BASE_URL for a local LLM gateway — the gateway has
# no /v1/agents route and answers with a plain `404 page not found`.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides
# NOVITA_TEMPLATE_NAME=openai-agents-api-executor
# NOVITA_BUILD_TAG=
# AGENTS_MODEL=gpt-5.6-luna
